{
  "name": "mfilmory",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.11",
  "description": "mfilmory — Afilmory 的静态 Web 前端 fork（Vite + React SPA，无后端 / 无 SSR / 无移动端）",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Afilmory/Afilmory"
  },
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "dev": "pnpm --filter @afilmory/web dev",
    "build": "pnpm --filter @afilmory/web build",
    "build:manifest": "pnpm --filter @afilmory/builder cli",
    "build:manifest:force": "pnpm --filter @afilmory/builder cli --force",
    "build:demo": "node scripts/prepare-demo-data.mjs && pnpm --filter @afilmory/web build",
    "preview": "pnpm --filter @afilmory/web serve",
    "og:middleware": "tsx scripts/generate-og-middleware.ts",
    "deploy:cloudflare": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --preview",
    "migrate:manifest": "tsx scripts/migrate-manifest.ts",
    "type-check": "pnpm run -r type-check",
    "lint": "eslint --fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "dependencies": {
    "@afilmory/builder": "workspace:*",
    "@afilmory/hooks": "workspace:*",
    "@afilmory/ui": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "dotenv": "18.0.7",
    "es-toolkit": "1.52.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@innei/prettier": "1.0.0",
    "@types/node": "26.6.5",
    "ast-kit": "3.0.0",
    "dotenv-expand": "catalog:",
    "eslint": "10.12.0",
    "eslint-config-hyoban": "7.0.3",
    "fast-glob": "3.3.3",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "unplugin-ast": "0.19.2",
    "vite": "8.3.4",
    "vite-bundle-analyzer": "1.3.9",
    "vite-plugin-checker": "0.14.5",
    "vite-tsconfig-paths": "6.1.1"
  }
}
