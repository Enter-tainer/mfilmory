node_modules
.DS_Store
dist
*.local

public/og-image-*.png

# user-editable, git-ignored configuration
config.json
.env
builder.config.ts
builder.config.ts.bak

# photo pipeline output
photos/
apps/web/assets-git
apps/web/src/data/photos-manifest.json
apps/web/src/data/.cache/
apps/web/public/thumbnails
apps/web/public/photos
