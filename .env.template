# S3-compatible storage (Cloudflare R2, Backblaze B2, MinIO, ...)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_NAME=
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public CDN domain for the photos (optional; falls back to the endpoint + bucket path)
S3_CUSTOM_DOMAIN=

# Regex of keys to skip while scanning the bucket (optional)
S3_EXCLUDE_REGEX=

# Token for the builder's github-repo-sync plugin, if you write the manifest back to GitHub
GIT_TOKEN=

# Geocoding for the builder's geocoding plugin (optional)
MAPBOX_TOKEN=
